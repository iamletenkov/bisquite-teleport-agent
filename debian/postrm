#!/bin/sh
# postrm of bisquite-teleport-agent. The package files are gone already, so
# this script stands alone. It removes only links that point into the
# package. The registration is never removed here, not even by purge:
# /var/lib/teleport, /etc/bisquite/teleport (config, apps.d, labels token),
# /etc/teleport.yaml and /var/lib/bisquite/teleport stay until
# `bisquite-teleport leave` (run it before removing the package).
# BISQUITE_TELEPORT_ROOT — a scratch root for the tests.
set -e
R="${BISQUITE_TELEPORT_ROOT:-}"
PKG=/usr/lib/bisquite-teleport
UNITS="teleport.service bisquite-teleport-apps.path bisquite-teleport-apps.service
bisquite-teleport-token.path bisquite-teleport-token.service
bisquite-teleport-labels.service bisquite-teleport-labels.timer
bisquite-teleport-join.service bisquite-teleport-join.timer"

# unlink_if <link> <target prefix>
unlink_if(){
    [ -L "$1" ] || return 0
    case "$(readlink "$1")" in
        "$2"*) rm -f -- "$1" ;;
    esac
}

case "$1" in
    remove|purge)
        unlink_if "$R/usr/local/sbin/bisquite-teleport" /usr/sbin/bisquite-teleport
        unlink_if "$R/usr/local/sbin/bisquite-conf" "$R$PKG/"
        unlink_if "$R/opt/bisquite/knobs/teleport" "$R$PKG/"
        unlink_if "$R/opt/bisquite/knobs/teleport.apply" "$R$PKG/"
        if [ "$1" = purge ]; then
            for u in $UNITS; do
                for l in "$R"/etc/systemd/system/*.wants/"$u"; do
                    unlink_if "$l" /usr/lib/systemd/system/
                done
            done
            if [ -s "$R/var/lib/teleport/host_uuid" ]; then
                echo "bisquite-teleport-agent: регистрация сохранена (/var/lib/teleport, /etc/bisquite/teleport); стереть — переустановить пакет и выполнить bisquite-teleport leave" >&2
            fi
        fi
        if [ -z "$R" ] && [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;
esac
exit 0
