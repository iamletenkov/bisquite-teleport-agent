#!/bin/sh
# postinst of bisquite-teleport-agent: the work is in pkg-setup (bash).
# BISQUITE_TELEPORT_ROOT — a scratch root for the tests.
set -e
case "$1" in
    configure)
        exec "${BISQUITE_TELEPORT_ROOT:-}/usr/lib/bisquite-teleport/pkg-setup" configure "${2:-}" ;;
    abort-upgrade|abort-remove|abort-deconfigure) ;;
esac
exit 0
