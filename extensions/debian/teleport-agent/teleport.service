[Unit]
Description=Teleport agent (SSH node and apps), bisquite-teleport
Documentation=https://goteleport.com/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5
# The config is generated from /etc/bisquite/teleport on every start, so a
# hand edit of /etc/teleport.yaml never silently diverges from `status`.
ExecStartPre=/usr/local/sbin/bisquite-teleport render
ExecStart=/usr/local/bin/teleport start --config /etc/teleport.yaml --pid-file=/run/teleport.pid
# HUP is Teleport's graceful restart: open SSH sessions survive a new app list.
ExecReload=/usr/local/sbin/bisquite-teleport render
ExecReload=/bin/kill -HUP $MAINPID
PIDFile=/run/teleport.pid
LimitNOFILE=524288

[Install]
WantedBy=multi-user.target
