#!/usr/bin/env bash
# bisquite-teleport — подключение машины к Teleport: SSH-нода и веб-приложения.
#
#   bisquite-teleport join KEY=VALUE…   зарегистрироваться (первая загрузка, переезд)
#   bisquite-teleport set KEY=VALUE…    метки и приложения без переподключения
#   bisquite-teleport leave             отключиться: агент выключен, состояние стёрто
#   bisquite-teleport status            что настроено, зарегистрирован ли, что опубликовано
#   bisquite-teleport render            собрать /etc/teleport.yaml (зовёт teleport.service)
#   bisquite-teleport apply             применить записанное к работающему агенту (хук)
#   bisquite-teleport os-logins         логины ОС одной строкой (метка os_logins, зовёт агент)
#   bisquite-teleport set-managed env=… space=…   метки, которыми управляет портал
#   bisquite-teleport pull              забрать метки с портала и применить (зовёт таймер)
#   bisquite-teleport labels-enable URL=…   включить автоприменение (токен — со stdin)
#
# Ручки — /etc/bisquite/teleport/config (0600), домен `teleport` библиотеки
# bisquite-conf; типы и шаблоны значений — схема knobs рядом со скриптом.
# `set` — то же, что `bisquite-conf set --apply teleport`:
#
#   TELEPORT_PROXY=host[:443]       прокси кластера; только через join
#   TELEPORT_JOIN_METHOD=token      token | bound_keypair; только через join
#   TELEPORT_TOKEN=                 token: join-токен (node[,app]), стирается после
#                                   регистрации; bound_keypair: имя токена, остаётся
#   TELEPORT_CA_PIN=sha256:…        необязательно: сверка CA кластера
#   TELEPORT_ENV=                   метка env — по ней smart_role даёт доступ
#   TELEPORT_NODENAME=              пусто — короткое имя хоста
#   TELEPORT_LABELS=k=v,k=v         прочие метки ноды (env/app/managed_by нельзя)
#   TELEPORT_APPS=имя=порт|URI,…    приложения оператора, любой адрес
#   TELEPORT_APPS_DISABLE=имя,…     не публиковать объявленное
#   TELEPORT_APPS_ICONS=имя=икон,…  иконка приложения в веб-морде прокси
#   TELEPORT_APPS_DISCOVERY=1       0 — не читать /etc/bisquite/teleport/apps.d
#   TELEPORT_OS_LOGINS=1            0 — без динамической метки ноды os_logins
#   TELEPORT_LABELS_URL=            адрес меток на портале; задаёт labels-enable
#
# Метки с портала (space и env): портал — источник правды о том, в каком
# пространстве робот. `labels-enable URL=https://<портал>/robot-api/v1/labels`
# читает токен со stdin в /etc/bisquite/teleport/labels-token (0600; не ручка:
# ручки печатает `status`) и включает bisquite-teleport-labels.timer; тик
# таймера — `pull`. Он сверяет ожидаемые метки (последний ответ портала,
# /var/lib/bisquite/teleport/labels-expected) с фактическими ручками на
# каждом тике и при расхождении зовёт `set-managed`: space сливается в
# TELEPORT_LABELS (прочие метки оператора остаются), env — в TELEPORT_ENV,
# агент перезапускается один раз (не HUP: открытые SSH-сессии людей прежнего
# пространства рвутся, узел и приложения переезжают одновременно).
#
# Только в join, для TELEPORT_JOIN_METHOD=bound_keypair (не ручки — в config
# не пишутся, в вывод не попадают):
#
#   TELEPORT_REGISTRATION_SECRET=-          секрет регистрации со stdin (или значением)
#   TELEPORT_REGISTRATION_SECRET_FILE=путь  …или из файла
#
# Секрет лежит в /var/lib/bisquite/teleport/registration-secret (0600) до
# регистрации и стирается после неё; связанный ключ агент хранит в своём
# /var/lib/teleport, и повторные подключения секрета не требуют.
#
# Объявления расширений — /etc/bisquite/teleport/apps.d/<имя>.conf, root:root,
# не шире 0644, два обязательных ключа и один необязательный:
#
#   NAME=code-server
#   URI=https://127.0.0.1:9002      только петля
#   ICON=mcpVscode                  имя иконки в веб-морде прокси
#
# ПРАВО ДОСТУПА ЗАДАЁТ ТОЛЬКО ОПЕРАТОР. Роль smart_role стека сверяет метку
# env с tpEnv пользователя, app — с tpApps. Приложение получает метки ноды
# плюс app=<имя>; единственная метка, которую объявление задаёт само, —
# teleport.icon, и решением о доступе она не является. Поэтому файл,
# положенный расширением или кем-то ещё, не открывает приложение чужому env.
set -uo pipefail

ROOT="${BISQUITE_TELEPORT_ROOT:-}"
# The settings library sees the same scratch root as this script.
export BISQUITE_CONF_ROOT="${BISQUITE_CONF_ROOT:-$ROOT}"
# /usr/local/sbin/bisquite-teleport is a link into the extension directory;
# resolving it finds lib/bisquite-conf of the same build.
SELF_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
# shellcheck source=/dev/null
source "$SELF_DIR/lib/bisquite-conf"
CONF="$ROOT/etc/bisquite/teleport/config"
APPS_DIR="$ROOT/etc/bisquite/teleport/apps.d"
YAML="$ROOT/etc/teleport.yaml"
DATA="$ROOT/var/lib/teleport"
STATE="$ROOT/var/lib/bisquite/teleport"
ROLLBACK="$STATE/rollback"
# The path the agent reads (teleport.yaml), and the same file under the
# scratch root of the tests.
REG_SECRET_GUEST=/var/lib/bisquite/teleport/registration-secret
REG_SECRET="$ROOT$REG_SECRET_GUEST"
# bound_keypair joining for agents (not only bots) appeared in Teleport 18.8.
BOUND_KEYPAIR_MIN=18.8.0
TELEPORT_BIN="${TELEPORT_BIN:-/usr/local/bin/teleport}"
JOIN_TIMEOUT="${BISQUITE_TELEPORT_JOIN_TIMEOUT:-120}"
MANAGED_BY=bisquite-teleport-agent
# The path the agent execs for the os_logins label: the link install.sh lays
# down, not $0 — render also runs under a scratch root in the tests.
OS_LOGINS_CMD=/usr/local/sbin/bisquite-teleport
# Teleport puts no limit on a label value, but the value travels in every
# heartbeat, `tsh ls` and the portal; a list longer than this is cut at a
# whole name and ends with `,...`.
OS_LOGINS_MAX=255

# The knob values are validated by the schema (knobs); these two check what
# is not a knob: the hostname fallback of the node name and apps.d files.
RE_NODENAME='^[a-z0-9][a-z0-9-]{1,62}$'
RE_APP_NAME='^[a-z0-9][a-z0-9-]{0,62}$'
# The icon name is a key of the proxy's compiled-in icon set, which this
# script cannot see; only the alphabet of real keys is checked (there are
# `apollo.io`, `mcpVscode`, `1password` among them). An unknown name is not
# an error for the proxy — it falls back to guessing by app name, so a typo
# is silent. See README.
RE_APP_ICON='^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$'
RE_LOOPBACK_URI='^https?://(127\.0\.0\.1|localhost|\[::1\])(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?$'
# The registration secret is not a knob: it goes to a file, never to YAML or
# the config, so only its shape is checked — one printable word.
RE_REG_SECRET='^[[:graph:]]{8,1024}$'
# Labels from the portal (contract GET /robot-api/v1/labels). Values are
# checked here before they reach the config: a DNS-label alphabet, so no
# quote, comma, `=` or newline can reach TELEPORT_LABELS or YAML.
RE_MANAGED_VALUE='^[a-z0-9][a-z0-9-]{0,62}$'
RE_LABELS_TOKEN='^[A-Za-z0-9_-]{43}$'
RE_LABELS_URL='^https://[a-z0-9.-]+(:[0-9]{1,5})?/robot-api/v1/labels$'
RE_REVISION='^[0-9a-f]{16}$'
LABELS_TOKEN="$ROOT/etc/bisquite/teleport/labels-token"
LABELS_EXPECTED="$STATE/labels-expected"
LABELS_APPLIED="$STATE/labels-applied"
LABELS_TIMER=bisquite-teleport-labels.timer
RESTART_TIMEOUT="${BISQUITE_TELEPORT_RESTART_TIMEOUT:-30}"

log(){ >&2 echo "bisquite-teleport: $*"; }
warn(){ log "ВНИМАНИЕ: $*"; }
die(){ log "ОШИБКА: $*"; exit 1; }

need_root(){ [[ -n "$ROOT" || "$(id -u)" -eq 0 ]] || die "нужен root (sudo)"; }
# BISQUITE_TELEPORT_SYSTEMD=1|0 overrides the detection — the tests drive a
# fake systemctl under a scratch root.
has_systemd(){
    case "${BISQUITE_TELEPORT_SYSTEMD:-}" in
        1) return 0 ;;
        0) return 1 ;;
    esac
    [[ -z "$ROOT" && -d /run/systemd/system ]]
}

# ---------------------------------------------------------------------------
# Файл ручек — через bisquite-conf: без `source`, со схемой knobs.
# ---------------------------------------------------------------------------
declare -A C=()
KEYS=()

load_conf(){
    local k
    conf_load teleport || die "ручки $CONF не прочитаны"
    mapfile -t KEYS < <(conf_keys teleport)
    for k in "${KEYS[@]}"; do C[$k]="${!k}"; done
}

# Write through the library: validation, atomic write, 0600. ro keys (proxy,
# token) are allowed here — this script is their owner.
save_conf(){
    (( $# )) || return 0
    conf_set teleport --allow-ro "$@" || die "не записано в $CONF"
}

# The one rule the schema cannot express: env, app, managed_by and os_logins
# are set by this script, and a label may not override the access decision
# or pose as the agent's own report of the OS logins.
check_labels(){
    local val="$1" item
    local -a items
    [[ -n "$val" ]] || return 0
    IFS=',' read -r -a items <<< "$val"
    for item in "${items[@]}"; do
        case "${item%%=*}" in
            env|app|managed_by)
                die "TELEPORT_LABELS: ключ '${item%%=*}' зарезервирован (env задаётся TELEPORT_ENV)" ;;
            # A static label and a dynamic one of the same name: the dynamic
            # one wins in Teleport, so the operator's value would be silently
            # lost. Refused like env.
            os_logins)
                die "TELEPORT_LABELS: ключ 'os_logins' зарезервирован — динамическая метка ставится агентом (выключить: TELEPORT_OS_LOGINS=0)" ;;
            # A node-wide icon label would land in the same YAML map as the
            # app's own one — a duplicate key, and teleport.yaml would not
            # parse at all.
            teleport.icon)
                die "TELEPORT_LABELS: ключ 'teleport.icon' зарезервирован — иконка задаётся ICON= в apps.d или ручкой TELEPORT_APPS_ICONS" ;;
        esac
    done
}

proxy_with_port(){ [[ "$1" == *:* ]] && echo "$1" || echo "$1:443"; }
proxy_host(){ echo "${1%%:*}"; }

nodename(){
    local n="${C[TELEPORT_NODENAME]}"
    [[ -n "$n" ]] || n="$(hostname -s 2>/dev/null | tr '[:upper:]' '[:lower:]')"
    [[ "$n" =~ $RE_NODENAME ]] || die "имя ноды '$n' (hostname) не метка DNS — задайте TELEPORT_NODENAME"
    echo "$n"
}

# ---------------------------------------------------------------------------
# Приложения: apps.d + TELEPORT_APPS − TELEPORT_APPS_DISABLE
# Выход: строки "имя<TAB>URI<TAB>источник", пропуски — в stderr.
# ---------------------------------------------------------------------------
read_decl(){
    local f="$1" line key val name="" uri="" icon="" owner mode
    # A symlink would pass the owner check while pointing at anyone's file.
    if [[ -L "$f" ]]; then
        warn "пропускаю $f: символическая ссылка"; return 1
    fi
    owner="$(stat -c %u "$f")"; mode="$(stat -c %a "$f")"
    if [[ -z "$ROOT" && "$owner" != 0 ]]; then
        warn "пропускаю $f: владелец не root"; return 1
    fi
    if (( (8#$mode & 8#022) != 0 )); then
        warn "пропускаю $f: права $mode, запись группе или всем"; return 1
    fi
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
        if [[ ! "$line" =~ ^([A-Z]+)=(.*)$ ]]; then
            warn "пропускаю $f: строка не KEY=VALUE"; return 1
        fi
        key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"
        case "$key" in
            NAME) name="$val" ;;
            URI) uri="$val" ;;
            ICON) icon="$val" ;;
            *) warn "пропускаю $f: неизвестный ключ $key (разрешены NAME, URI и ICON)"; return 1 ;;
        esac
    done < "$f"
    [[ "$name" =~ $RE_APP_NAME ]] || { warn "пропускаю $f: NAME='$name' не метка DNS"; return 1; }
    [[ "$uri" =~ $RE_LOOPBACK_URI ]] || { warn "пропускаю $f: URI='$uri' — в apps.d только петля"; return 1; }
    if [[ -n "$icon" && ! "$icon" =~ $RE_APP_ICON ]]; then
        warn "пропускаю $f: ICON='$icon' не имя иконки"; return 1
    fi
    # The icon goes last: an empty field between two tabs collapses on read.
    printf '%s\t%s\t%s\t%s\n' "$name" "$uri" "$f" "$icon"
}

collect_apps(){
    local -A uri=() src=() disabled=() icon=()
    local order=() f line name u ic item
    local -a items
    if [[ "${C[TELEPORT_APPS_DISCOVERY]}" == 1 && -d "$APPS_DIR" ]]; then
        for f in "$APPS_DIR"/*.conf; do
            [[ -f "$f" ]] || continue
            line="$(read_decl "$f")" || continue
            IFS=$'\t' read -r name u _ ic <<< "$line"
            if [[ -n "${uri[$name]:-}" ]]; then
                warn "пропускаю $f: приложение '$name' уже объявлено в ${src[$name]}"; continue
            fi
            uri[$name]="$u"; src[$name]="$f"; icon[$name]="$ic"; order+=("$name")
        done
    fi
    if [[ -n "${C[TELEPORT_APPS]}" ]]; then
        IFS=',' read -r -a items <<< "${C[TELEPORT_APPS]}"
        for item in "${items[@]}"; do
            name="${item%%=*}"; u="${item#*=}"
            [[ "$u" =~ ^[0-9]+$ ]] && u="http://127.0.0.1:$u"
            # The operator's entry wins over a declaration of the same name.
            [[ -n "${uri[$name]:-}" ]] || order+=("$name")
            uri[$name]="$u"; src[$name]="TELEPORT_APPS"
        done
    fi
    if [[ -n "${C[TELEPORT_APPS_ICONS]}" ]]; then
        IFS=',' read -r -a items <<< "${C[TELEPORT_APPS_ICONS]}"
        # The operator's icon wins over the declaration's, the same way the
        # operator's URI does. A name that nothing publishes is ignored.
        for item in "${items[@]}"; do icon[${item%%=*}]="${item#*=}"; done
    fi
    if [[ -n "${C[TELEPORT_APPS_DISABLE]}" ]]; then
        IFS=',' read -r -a items <<< "${C[TELEPORT_APPS_DISABLE]}"
        for item in "${items[@]}"; do disabled[$item]=1; done
    fi
    for name in "${order[@]}"; do
        [[ -n "${disabled[$name]:-}" ]] && continue
        printf '%s\t%s\t%s\t%s\n' "$name" "${uri[$name]}" "${src[$name]}" "${icon[$name]:-}"
    done
}

node_labels(){
    local -A l=() ; local item k
    local -a items
    if [[ -n "${C[TELEPORT_LABELS]}" ]]; then
        IFS=',' read -r -a items <<< "${C[TELEPORT_LABELS]}"
        for item in "${items[@]}"; do l[${item%%=*}]="${item#*=}"; done
    fi
    l[managed_by]="$MANAGED_BY"
    # env last and never from TELEPORT_LABELS: it is the access decision.
    [[ -n "${C[TELEPORT_ENV]}" ]] && l[env]="${C[TELEPORT_ENV]}"
    for k in $(printf '%s\n' "${!l[@]}" | sort); do printf '%s\t%s\n' "$k" "${l[$k]}"; done
}

# ---------------------------------------------------------------------------
# teleport.yaml — форма install.sh ldap-admin-api
# ---------------------------------------------------------------------------
cmd_render(){
    need_root
    load_conf
    # A hand edit or sed may have put anything into the file: every value is
    # checked against the schema before it lands in YAML.
    conf_check teleport || die "в $CONF неверные значения — bisquite-conf show teleport"
    check_labels "${C[TELEPORT_LABELS]}"
    [[ -n "${C[TELEPORT_PROXY]}" ]] || die "TELEPORT_PROXY не задан — сначала bisquite-teleport join"
    local node proxy host apps labels tmp name uri icon
    node="$(nodename)"
    proxy="$(proxy_with_port "${C[TELEPORT_PROXY]}")"
    host="$(proxy_host "$proxy")"
    labels="$(node_labels)"
    apps="$(collect_apps)"

    tmp="$(mktemp "$(dirname "$YAML")/.teleport.yaml.XXXXXX")"
    chmod 0600 "$tmp"
    {
        echo "# Сгенерирован bisquite-teleport render из /etc/bisquite/teleport. Не править:"
        echo "# перезаписывается на каждом старте teleport.service."
        echo "version: v3"
        echo "teleport:"
        echo "  nodename: \"$node\""
        echo "  data_dir: /var/lib/teleport"
        echo "  log:"
        echo "    output: stderr"
        echo "    severity: INFO"
        [[ -n "${C[TELEPORT_CA_PIN]}" ]] && echo "  ca_pin: \"${C[TELEPORT_CA_PIN]}\""
        echo "  proxy_server: \"$proxy\""
        if [[ -n "${C[TELEPORT_TOKEN]}" ]]; then
            echo "  join_params:"
            echo "    token_name: \"${C[TELEPORT_TOKEN]}\""
            if [[ "${C[TELEPORT_JOIN_METHOD]}" == bound_keypair ]]; then
                echo "    method: bound_keypair"
                # Only the first join reads the secret: afterwards the key
                # bound in data_dir authenticates, and the scrubbed secret
                # leaves no path to a missing file behind.
                if [[ -s "$REG_SECRET" ]]; then
                    echo "    bound_keypair:"
                    echo "      registration_secret_path: \"$REG_SECRET_GUEST\""
                fi
            else
                echo "    method: token"
            fi
        fi
        echo "ssh_service:"
        echo "  enabled: yes"
        # Reached through the proxy's reverse tunnel; nothing needs 3022 from
        # the network.
        echo "  listen_addr: 127.0.0.1:3022"
        echo "  labels:"
        while IFS=$'\t' read -r k v; do echo "    \"$k\": \"$v\""; done <<< "$labels"
        # Dynamic label: the agent runs the command every period and puts its
        # trimmed stdout into the label. Node only — apps do not get it.
        if [[ "${C[TELEPORT_OS_LOGINS]}" == 1 ]]; then
            echo "  commands:"
            echo "    - name: \"os_logins\""
            echo "      command: [\"$OS_LOGINS_CMD\", \"os-logins\"]"
            echo "      period: 5m0s"
        fi
        if [[ -n "$apps" ]]; then
            echo "app_service:"
            echo "  enabled: yes"
            echo "  apps:"
            while IFS=$'\t' read -r name uri _ icon; do
                echo "    - name: \"$name-$node\""
                echo "      uri: \"$uri\""
                echo "      public_addr: \"$name.$node.$host\""
                # Loopback https carries a localhost certificate (mkcert,
                # self-signed); nobody outside can sit on the loopback path.
                if [[ "$uri" =~ ^https://(127\.0\.0\.1|localhost|\[::1\])[:/] || "$uri" =~ ^https://(127\.0\.0\.1|localhost|\[::1\])$ ]]; then
                    echo "      insecure_skip_verify: true"
                fi
                # Loopback apps see the public Host, as behind any reverse
                # proxy. Teleport forwards Host 127.0.0.1:<port> by default,
                # and apps guarding WebSocket by Origin == Host reject the
                # browser: Selkies answered 403 "disallowed Origin" until
                # this (AGX Orin, 2026-09-14). Remote operator apps keep
                # their Host — it may select a virtual host there.
                if [[ "$uri" =~ ^https?://(127\.0\.0\.1|localhost|\[::1\])([:/]|$) ]]; then
                    echo "      rewrite:"
                    echo "        headers:"
                    echo "          - \"Host: $name.$node.$host\""
                fi
                echo "      labels:"
                while IFS=$'\t' read -r k v; do echo "        \"$k\": \"$v\""; done <<< "$labels"
                echo "        \"app\": \"$name\""
                # No icon — no label: the proxy then guesses by app name,
                # which is what an app named `grafana` wants.
                [[ -n "$icon" ]] && echo "        \"teleport.icon\": \"$icon\""
            done <<< "$apps"
        else
            echo "app_service:"
            echo "  enabled: no"
        fi
        echo "auth_service:"
        echo "  enabled: no"
        echo "proxy_service:"
        echo "  enabled: no"
    } > "$tmp"
    mv -f "$tmp" "$YAML"
}

# ---------------------------------------------------------------------------
# os-logins — значение динамической метки os_logins
# ---------------------------------------------------------------------------
# Accounts with an interactive shell: root and uid >= 1000 (not nobody),
# shell not nologin/false/…; an empty shell field means /bin/sh. The source is
# NSS (`getent passwd`): directory users show up only where NSS enumerates
# them (sssd does not by default). A name outside the label alphabet is
# skipped rather than mangled — a mangled name would be a login that does not
# exist.
#
# Always exit 0: on a non-zero exit Teleport puts the error text into the
# label instead of a list.
cmd_os_logins(){
    local passwd name uid shell out="" n
    local -a names=()
    if [[ -n "$ROOT" ]]; then
        passwd="$(cat "$ROOT/etc/passwd" 2>/dev/null)" || passwd=""
    else
        passwd="$(getent passwd 2>/dev/null)" || passwd=""
    fi
    while IFS=: read -r name _ uid _ _ _ shell; do
        [[ "$name" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]{0,31}$ && "$uid" =~ ^[0-9]+$ ]] || continue
        (( uid == 0 || (uid >= 1000 && uid != 65534) )) || continue
        case "${shell##*/}" in
            nologin|false|true|sync|shutdown|halt) continue ;;
        esac
        names+=("$name")
    done <<< "$passwd"
    (( ${#names[@]} )) || return 0
    mapfile -t names < <(printf '%s\n' "${names[@]}" | LC_ALL=C sort -u)
    out="$(IFS=,; echo "${names[*]}")"
    if (( ${#out} > OS_LOGINS_MAX )); then
        # Whole names only, then the marker: `,...` is 4 characters.
        out=""
        for n in "${names[@]}"; do
            (( ${#out} + 1 + ${#n} + 4 <= OS_LOGINS_MAX )) || break
            out+="${out:+,}$n"
        done
        out+=",..."
    fi
    printf '%s\n' "$out"
}

# ---------------------------------------------------------------------------
# Служба
# ---------------------------------------------------------------------------
joined(){ [[ -s "$DATA/host_uuid" ]]; }

# Teleport 18 joins roles separately: a token without App still registers the
# SSH node, and app_service keeps retrying with this error (seen on AGX Orin
# 2026-09-14). The identity cannot gain App without a new provision token.
APP_ROLE_ERROR='token does not allow role App'
app_role_missing(){
    has_systemd || return 1
    local inv log
    inv="$(systemctl show teleport.service -p InvocationID --value 2>/dev/null)"
    [[ -n "$inv" ]] || return 1
    # Into a variable, not `| grep -q`: grep exits on the first match, the
    # writer gets SIGPIPE, and pipefail turns the match into a failure.
    log="$(journalctl -u teleport.service "_SYSTEMD_INVOCATION_ID=$inv" --no-pager -o cat 2>/dev/null)"
    grep -q "$APP_ROLE_ERROR" <<< "$log"
}
APP_ROLE_HINT="у токена не было роли App: SSH работает, приложения не опубликованы. Выдайте токен с ролями node,app (в админке — «Разрешить веб-приложения») и выполните join с TELEPORT_FORCE=1"
agent_active(){ has_systemd && systemctl is-active --quiet teleport.service; }

# join waits on purpose: it reports the registration. The hook below does not.
apply_running(){
    has_systemd || return 0
    if agent_active; then
        cmd_render
        systemctl reload teleport.service || systemctl restart teleport.service
    fi
}

# Apply hook (knobs.apply): render synchronously — a bad value fails loudly
# here — and hand the reload to systemd without waiting: `bisquite-conf set`
# may run inside cloud-final.
cmd_apply(){
    need_root
    load_conf
    if [[ -z "${C[TELEPORT_PROXY]}" ]]; then
        log "записано; кластер не задан — bisquite-teleport join"
        return 0
    fi
    if agent_active; then
        cmd_render
        systemctl --no-block reload-or-restart teleport.service || die "teleport.service не принял reload"
        log "применено к работающему агенту"
    else
        log "записано; применится при старте агента"
    fi
}

# The registration secret becomes inert once used. The token name and the
# method stay: they are not secret, and a re-join (a new system role, a CA
# rotation) authenticates with the bound key under them.
scrub_secret(){
    [[ -e "$REG_SECRET" ]] || return 0
    rm -f -- "$REG_SECRET"
    [[ -n "${C[TELEPORT_PROXY]}" ]] && cmd_render
    log "агент зарегистрирован — секрет регистрации стёрт, связанный ключ — в $DATA"
}

write_secret(){
    local tmp
    install -d -m 0700 "$STATE"
    # mktemp creates the file 0600: the secret is never readable by others.
    tmp="$(mktemp "$STATE/.registration-secret.XXXXXX")" || die "не создать файл в $STATE"
    printf '%s\n' "$1" > "$tmp" || { rm -f -- "$tmp"; die "секрет регистрации не записан"; }
    mv -f -- "$tmp" "$REG_SECRET"
}

scrub_token(){
    load_conf
    joined || return 0
    if [[ "${C[TELEPORT_JOIN_METHOD]}" == bound_keypair ]]; then
        scrub_secret
        return 0
    fi
    [[ -n "${C[TELEPORT_TOKEN]}" ]] || return 0
    C[TELEPORT_TOKEN]=""
    save_conf TELEPORT_TOKEN=
    # teleport.yaml carries the token too; rewrite it without restarting —
    # a joined agent reads its identity from DATA, not from join_params.
    [[ -n "${C[TELEPORT_PROXY]}" ]] && cmd_render
    log "агент зарегистрирован — токен стёрт из $CONF и $YAML"
}

# ---------------------------------------------------------------------------
# join
# ---------------------------------------------------------------------------
version_of_agent(){ "$TELEPORT_BIN" version 2>/dev/null | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | head -1 | tr -d v; }

# 0 — a is newer than b
semver_gt(){
    local -a a b; local i
    IFS=. read -r -a a <<< "$1"
    IFS=. read -r -a b <<< "$2"
    for i in 0 1 2; do
        (( ${a[i]:-0} > ${b[i]:-0} )) && return 0
        (( ${a[i]:-0} < ${b[i]:-0} )) && return 1
    done
    return 1
}

# Echo the server version; return 1 if the proxy is unreachable over verified TLS.
probe_proxy(){
    local proxy="$1" body
    body="$(curl -fsS --max-time 15 "https://$proxy/webapi/find" 2>/dev/null)" || return 1
    grep -oE '"server_version":"[^"]+"' <<< "$body" | head -1 | cut -d'"' -f4
}

cmd_join(){
    need_root
    local -A N=()
    local -a pairs=()
    local pair key val
    for pair in "$@"; do
        [[ "$pair" == *=* ]] || die "ожидали KEY=VALUE, получили '$pair'"
        key="${pair%%=*}"; val="${pair#*=}"
        N[$key]="$val"
    done
    if [[ "${N[TELEPORT_TOKEN]:-}" == - && "${N[TELEPORT_REGISTRATION_SECRET]:-}" == - ]]; then
        die "со stdin читается одно значение: TELEPORT_TOKEN=- или TELEPORT_REGISTRATION_SECRET=-"
    fi
    if [[ "${N[TELEPORT_TOKEN]:-}" == - ]]; then
        IFS= read -r val || true
        N[TELEPORT_TOKEN]="$val"
    fi
    [[ -n "${N[TELEPORT_PROXY]:-}" ]] || die "нужен TELEPORT_PROXY=host[:port]"
    [[ -n "${N[TELEPORT_TOKEN]:-}" ]] || die "нужен TELEPORT_TOKEN (или TELEPORT_TOKEN=- со stdin)"
    local force="${N[TELEPORT_FORCE]:-0}"; unset 'N[TELEPORT_FORCE]'
    # The method follows this join, not the history: a join without it is a
    # token join even on a machine that was bound_keypair before.
    local method="${N[TELEPORT_JOIN_METHOD]:-token}"
    N[TELEPORT_JOIN_METHOD]="$method"
    # The registration secret is not a knob: it leaves N before validation
    # and never reaches the config, argv of children or the log.
    local secret="" has_secret=0
    if [[ -n "${N[TELEPORT_REGISTRATION_SECRET]+x}" && -n "${N[TELEPORT_REGISTRATION_SECRET_FILE]+x}" ]]; then
        die "секрет регистрации — одно из двух: TELEPORT_REGISTRATION_SECRET или TELEPORT_REGISTRATION_SECRET_FILE"
    fi
    if [[ -n "${N[TELEPORT_REGISTRATION_SECRET]+x}" ]]; then
        has_secret=1; secret="${N[TELEPORT_REGISTRATION_SECRET]}"
        if [[ "$secret" == - ]]; then IFS= read -r secret || true; fi
    elif [[ -n "${N[TELEPORT_REGISTRATION_SECRET_FILE]+x}" ]]; then
        has_secret=1
        [[ -f "${N[TELEPORT_REGISTRATION_SECRET_FILE]}" && -r "${N[TELEPORT_REGISTRATION_SECRET_FILE]}" ]] \
            || die "файл секрета регистрации '${N[TELEPORT_REGISTRATION_SECRET_FILE]}' не прочитать"
        secret="$(< "${N[TELEPORT_REGISTRATION_SECRET_FILE]}")"
    fi
    unset 'N[TELEPORT_REGISTRATION_SECRET]' 'N[TELEPORT_REGISTRATION_SECRET_FILE]'
    # Surrounding whitespace (a newline from echo or a file) is not the secret;
    # Teleport trims the file the same way.
    secret="${secret#"${secret%%[![:space:]]*}"}"; secret="${secret%"${secret##*[![:space:]]}"}"
    if [[ "$method" == bound_keypair ]]; then
        if (( has_secret )) && [[ ! "$secret" =~ $RE_REG_SECRET ]]; then
            die "секрет регистрации: ожидали 8–1024 печатных знаков без пробелов"
        fi
    elif (( has_secret )); then
        die "TELEPORT_REGISTRATION_SECRET* — только для TELEPORT_JOIN_METHOD=bound_keypair"
    fi
    for key in "${!N[@]}"; do pairs+=("$key=${N[$key]}"); done
    # Proxy and token are validated here and only here: they change through join.
    conf_validate teleport --allow-ro "${pairs[@]}" || exit 1
    check_labels "${N[TELEPORT_LABELS]:-}"
    N[TELEPORT_PROXY]="$(proxy_with_port "${N[TELEPORT_PROXY]}")"

    load_conf
    local old_proxy="${C[TELEPORT_PROXY]}"
    [[ -n "$old_proxy" ]] && old_proxy="$(proxy_with_port "$old_proxy")"

    # 1. Idempotent: a rerun of runcmd (cloned card, cloud-init clean) must
    #    not wipe a working identity with the stale token from the seed.
    if joined && [[ "$old_proxy" == "${N[TELEPORT_PROXY]}" && "$force" != 1 ]]; then
        log "уже зарегистрирован в ${N[TELEPORT_PROXY]} — переподключение не нужно (TELEPORT_FORCE=1 — принудительно)"
        pairs=()
        for key in "${!N[@]}"; do
            [[ "$key" == TELEPORT_PROXY || "$key" == TELEPORT_TOKEN || "$key" == TELEPORT_JOIN_METHOD ]] && continue
            pairs+=("$key=${N[$key]}")
        done
        save_conf "${pairs[@]}"
        apply_running
        return 0
    fi
    # Past the idempotent exit: a registered robot needs no secret to rerun.
    if [[ "$method" == bound_keypair && -z "$secret" ]]; then
        die "bound_keypair: нужен секрет регистрации — TELEPORT_REGISTRATION_SECRET=- (stdin) или TELEPORT_REGISTRATION_SECRET_FILE=<путь>"
    fi
    [[ -n "${C[TELEPORT_ENV]}${N[TELEPORT_ENV]:-}" ]] || \
        warn "TELEPORT_ENV не задан: ноду и приложения увидят только роли access/editor"

    # 2. Preflight before touching anything.
    local was_joined=0 server agent
    joined && was_joined=1
    agent="$(version_of_agent)"
    [[ -n "$agent" ]] || die "$TELEPORT_BIN не отвечает на version — расширение не установлено?"
    # The agent may not be newer than the cluster (below), so an agent of
    # 18.8+ also guarantees the cluster side of bound_keypair.
    if [[ "$method" == bound_keypair ]] && semver_gt "$BOUND_KEYPAIR_MIN" "$agent"; then
        die "bound_keypair: нужен агент версии не ниже $BOUND_KEYPAIR_MIN, установлен $agent — пересоберите образ с TELEPORT_VERSION ≥ $BOUND_KEYPAIR_MIN"
    fi
    if server="$(probe_proxy "${N[TELEPORT_PROXY]}")"; then
        if [[ -n "$server" ]]; then
            if semver_gt "$agent" "$server"; then
                die "агент $agent новее кластера $server — Teleport такую связку не поддерживает"
            fi
            if (( ${server%%.*} - ${agent%%.*} > 1 )); then
                die "агент $agent старше кластера $server больше чем на мажор"
            fi
            log "прокси ${N[TELEPORT_PROXY]} отвечает, кластер $server, агент $agent"
        fi
    elif (( was_joined )); then
        die "прокси ${N[TELEPORT_PROXY]} недоступен по https — рабочую регистрацию не трогаю"
    else
        warn "прокси ${N[TELEPORT_PROXY]} пока недоступен — агент будет повторять попытки"
    fi

    # 3. Keep the previous state for a rollback.
    if has_systemd; then systemctl stop teleport.service 2>/dev/null || true; fi
    rm -r -f -- "$ROLLBACK"
    install -d -m 0700 "$STATE" "$ROLLBACK" "$ROLLBACK/data"
    [[ -f "$CONF" ]] && cp -a "$CONF" "$ROLLBACK/config"
    [[ -f "$YAML" ]] && cp -a "$YAML" "$ROLLBACK/teleport.yaml"
    if [[ -d "$DATA" ]]; then
        find "$DATA" -mindepth 1 -maxdepth 1 -exec mv -t "$ROLLBACK/data" -- {} +
    fi
    install -d -m 0750 "$DATA"

    # A new cluster invalidates the old pin unless a new one came with it.
    pairs=()
    if [[ "$old_proxy" != "${N[TELEPORT_PROXY]}" && -z "${N[TELEPORT_CA_PIN]+x}" ]]; then
        pairs+=(TELEPORT_CA_PIN=)
    fi
    for key in "${!N[@]}"; do pairs+=("$key=${N[$key]}"); done
    save_conf "${pairs[@]}"
    # A secret of an earlier bound_keypair join must not outlive it.
    rm -f -- "$REG_SECRET"
    [[ "$method" == bound_keypair ]] && write_secret "$secret"
    cmd_render

    if ! has_systemd; then
        log "systemd не запущен — конфиг записан, агент стартует при загрузке"
        return 0
    fi
    systemctl enable teleport.service >/dev/null 2>&1
    systemctl start teleport.service

    # 4. Wait for the identity.
    local waited=0
    log "жду регистрации (до ${JOIN_TIMEOUT} с)…"
    while (( waited < JOIN_TIMEOUT )); do
        if joined; then
            rm -r -f -- "$ROLLBACK"
            scrub_token
            log "нода $(nodename) зарегистрирована в ${C[TELEPORT_PROXY]}"
            # Apps join after the node; give app_service a moment to fail.
            if [[ -n "$(collect_apps 2>/dev/null)" ]]; then
                sleep 15
                if app_role_missing; then warn "$APP_ROLE_HINT"; return 2; fi
            fi
            return 0
        fi
        sleep 2; waited=$((waited + 2))
    done

    # 5. Timed out.
    if [[ -s "$ROLLBACK/data/host_uuid" ]]; then
        warn "регистрация не подтвердилась за ${JOIN_TIMEOUT} с — возвращаю прежнее подключение"
        systemctl stop teleport.service
        find "$DATA" -mindepth 1 -maxdepth 1 -exec rm -r -f -- {} +
        find "$ROLLBACK/data" -mindepth 1 -maxdepth 1 -exec mv -t "$DATA" -- {} +
        [[ -f "$ROLLBACK/config" ]] && cp -a "$ROLLBACK/config" "$CONF"
        [[ -f "$ROLLBACK/teleport.yaml" ]] && cp -a "$ROLLBACK/teleport.yaml" "$YAML"
        # The restored registration has its own identity; the new secret goes.
        rm -f -- "$REG_SECRET"
        systemctl start teleport.service
        rm -r -f -- "$ROLLBACK"
        die "join не удался, прежняя регистрация восстановлена — journalctl -u teleport"
    fi
    rm -r -f -- "$ROLLBACK"
    die "регистрация не подтвердилась за ${JOIN_TIMEOUT} с; агент продолжает попытки — journalctl -u teleport -f"
}

# ---------------------------------------------------------------------------
# Validation and writing — the library; proxy and token are ro in the schema,
# so `set` refuses them with the schema's text. --apply keeps the behaviour
# `set` had before the library: a running agent picks the change up at once
# (the hook reloads without waiting).
cmd_set(){
    need_root
    (( $# )) || die "ожидали KEY=VALUE…"
    local pair
    for pair in "$@"; do
        [[ "$pair" == TELEPORT_LABELS=* ]] && check_labels "${pair#*=}"
    done
    conf_cli_set --apply teleport "$@" || exit 1
}

# ---------------------------------------------------------------------------
# Метки с портала: set-managed, pull, labels-enable
# ---------------------------------------------------------------------------
# The portal manages exactly two labels: space (one item of TELEPORT_LABELS)
# and env (TELEPORT_ENV). Every other operator label stays as it is.

# The space value of a TELEPORT_LABELS list; the last item wins, as in render.
labels_space(){
    local item out=""
    local -a items=()
    [[ -n "$1" ]] && IFS=',' read -r -a items <<< "$1"
    for item in "${items[@]}"; do
        [[ "${item%%=*}" == space ]] && out="${item#*=}"
    done
    printf '%s' "$out"
}

# TELEPORT_LABELS with space=$2: in place of the first space item (other
# space items dropped), appended when there was none.
labels_with_space(){
    local item out="" put=0
    local -a items=()
    [[ -n "$1" ]] && IFS=',' read -r -a items <<< "$1"
    for item in "${items[@]}"; do
        if [[ "${item%%=*}" == space ]]; then
            (( put )) && continue
            item="space=$2"; put=1
        fi
        out+="${out:+,}$item"
    done
    (( put )) || out+="${out:+,}space=$2"
    printf '%s' "$out"
}

# Restart, not reload: on HUP Teleport keeps the open SSH sessions of people
# of the old space while the apps already answer by the new labels. One
# restart moves the node and every app together (the sessions break, the
# robot is away for a few seconds). Then wait for the agent to be active.
restart_agent(){
    local waited=0
    systemctl restart teleport.service >/dev/null 2>&1 || true
    while :; do
        systemctl is-active --quiet teleport.service && return 0
        (( waited < RESTART_TIMEOUT )) || return 1
        sleep 1; waited=$((waited + 1))
    done
}

# Is the agent running with what the config says? Without systemd (a build,
# a chroot) the config is all there is.
agent_running(){
    [[ -n "${C[TELEPORT_PROXY]}" ]] || return 1
    has_systemd || return 0
    systemctl is-active --quiet teleport.service
}

# apply_managed <env|""> <space|""> — write through the library without the
# apply hook (its reload is the HUP above), then one restart. 0 — applied or
# nothing to change, 1 — the agent did not come up.
apply_managed(){
    local env="$1" space="$2" labels pair
    local -a pairs=()
    load_conf
    if [[ -n "$space" ]]; then
        labels="$(labels_with_space "${C[TELEPORT_LABELS]}" "$space")"
        [[ "$labels" != "${C[TELEPORT_LABELS]}" ]] && pairs+=("TELEPORT_LABELS=$labels")
    fi
    [[ -n "$env" && "$env" != "${C[TELEPORT_ENV]}" ]] && pairs+=("TELEPORT_ENV=$env")
    if (( ${#pairs[@]} == 0 )); then
        log "метки env и space уже такие — без изменений"
        return 0
    fi
    save_conf "${pairs[@]}"
    for pair in "${pairs[@]}"; do C[${pair%%=*}]="${pair#*=}"; done
    log "записано: ${pairs[*]}"
    if ! has_systemd; then
        log "systemd не запущен — применится при старте агента"
        return 0
    fi
    if [[ -z "${C[TELEPORT_PROXY]}" ]]; then
        log "кластер не задан — применится после bisquite-teleport join"
        return 0
    fi
    if ! restart_agent; then
        log "ОШИБКА: агент не поднялся за ${RESTART_TIMEOUT} с после перезапуска — journalctl -u teleport"
        return 1
    fi
    log "агент перезапущен: узел и приложения — с новыми метками"
}

cmd_set_managed(){
    need_root
    (( $# )) || die "set-managed: ожидали env=… и/или space=…"
    local pair key val env="" space="" seen=" "
    for pair in "$@"; do
        [[ "$pair" == *=* ]] || die "set-managed: ожидали KEY=VALUE"
        key="${pair%%=*}"; val="${pair#*=}"
        case "$key" in
            env|space) ;;
            *) die "set-managed: порталом управляются только env и space" ;;
        esac
        [[ "$seen" == *" $key "* ]] && die "set-managed: ключ $key задан дважды"
        seen+="$key "
        # The value is not echoed: it is external input.
        [[ "$val" =~ $RE_MANAGED_VALUE ]] \
            || die "set-managed: $key — ожидали 1–63 знака [a-z0-9-], первый — буква или цифра"
        if [[ "$key" == env ]]; then env="$val"; else space="$val"; fi
    done
    apply_managed "$env" "$space"
}

# Local state of the last portal answer. Read back with the same checks as
# the answer itself: a hand-edited file is no state at all.
read_expected(){
    local line
    EXP_REV=""; EXP_ENV=""; EXP_SPACE=""
    [[ -f "$LABELS_EXPECTED" ]] || return 1
    while IFS= read -r line; do
        case "$line" in
            revision=*) EXP_REV="${line#*=}" ;;
            env=*) EXP_ENV="${line#*=}" ;;
            space=*) EXP_SPACE="${line#*=}" ;;
        esac
    done < "$LABELS_EXPECTED"
    [[ "$EXP_REV" =~ $RE_REVISION && "$EXP_ENV" =~ $RE_MANAGED_VALUE && "$EXP_SPACE" =~ $RE_MANAGED_VALUE ]]
}
applied_revision(){
    local r=""
    [[ -f "$LABELS_APPLIED" ]] && r="$(< "$LABELS_APPLIED")"
    [[ "$r" =~ $RE_REVISION ]] && printf '%s' "$r"
    return 0
}
write_state(){ # write_state <file> <content>
    local tmp
    install -d -m 0700 "$STATE" || return 1
    tmp="$(mktemp "$STATE/.labels.XXXXXX")" || return 1
    printf '%s\n' "$2" > "$tmp" && mv -f -- "$tmp" "$1"
}
# Do the knobs carry what the portal expects?
labels_match(){
    load_conf
    [[ "${C[TELEPORT_ENV]}" == "$EXP_ENV" && "$(labels_space "${C[TELEPORT_LABELS]}")" == "$EXP_SPACE" ]]
}

# The 200 body of GET /robot-api/v1/labels: exactly
#   {"labels":{"env":"<v>","space":"<v>"},"revision":"<16 hex>"}
# keys in this order, each once, whitespace between tokens only. Anything
# else — a second object, a repeated key, an extra key — is refused whole.
parse_labels(){
    local f="$1" body w='[[:space:]]*' re
    [[ -f "$f" ]] || return 1
    (( $(wc -c < "$f") <= 4096 )) || return 1
    # A NUL would vanish on read and glue two halves into a valid value.
    [[ "$(wc -c < "$f")" == "$(tr -d '\000' < "$f" | wc -c)" ]] || return 1
    body="$(< "$f")"
    re="^${w}[{]${w}\"labels\"${w}:${w}[{]${w}\"env\"${w}:${w}\"([^\"]*)\"${w},${w}\"space\"${w}:${w}\"([^\"]*)\"${w}[}]${w},${w}\"revision\"${w}:${w}\"([^\"]*)\"${w}[}]${w}\$"
    [[ "$body" =~ $re ]] || return 1
    P_ENV="${BASH_REMATCH[1]}"; P_SPACE="${BASH_REMATCH[2]}"; P_REV="${BASH_REMATCH[3]}"
    [[ "$P_ENV" =~ $RE_MANAGED_VALUE && "$P_SPACE" =~ $RE_MANAGED_VALUE && "$P_REV" =~ $RE_REVISION ]]
}

# One tick of the timer. Network and HTTP errors: one journal line, code 0 —
# the next tick is the retry. A refused answer or an agent that did not come
# up: code 1. The token travels only in a header file curl reads (-H @file):
# never in argv, the journal or `status`.
cmd_pull(){
    need_root
    load_conf
    local url="${C[TELEPORT_LABELS_URL]}" token work code rc have_exp=0 report=0
    if [[ -z "$url" ]]; then
        log "метки с портала выключены: TELEPORT_LABELS_URL не задан — bisquite-teleport labels-enable"
        return 0
    fi
    [[ "$url" =~ $RE_LABELS_URL ]] || die "TELEPORT_LABELS_URL не по шаблону — bisquite-teleport labels-enable"
    if [[ ! -f "$LABELS_TOKEN" ]]; then
        log "метки с портала выключены: нет $LABELS_TOKEN — bisquite-teleport labels-enable"
        return 0
    fi
    token="$(< "$LABELS_TOKEN")"
    [[ "$token" =~ $RE_LABELS_TOKEN ]] \
        || die "$LABELS_TOKEN испорчен — выпустите токен меток на портале и выполните bisquite-teleport labels-enable"
    install -d -m 0700 "$STATE" || die "не создать $STATE"
    # One tick at a time: the timer and labels-enable may meet.
    if command -v flock >/dev/null 2>&1; then
        exec 9> "$STATE/.labels.lock"
        flock -n 9 || { log "метки уже запрашиваются — пропускаю тик"; return 0; }
    fi

    if read_expected; then
        have_exp=1
        # R3: report only what is really in effect — the knobs carry the
        # expected labels and the agent runs with them.
        if [[ "$(applied_revision)" == "$EXP_REV" ]] && labels_match && agent_running; then
            report=1
        fi
    fi
    work="$(mktemp -d "$STATE/.pull.XXXXXX")" || die "не создать каталог в $STATE"
    # shellcheck disable=SC2064  # the path is fixed now, on purpose
    trap "rm -r -f -- '$work'" EXIT
    {
        printf 'Authorization: Bearer %s\n' "$token"
        if (( have_exp )); then printf 'If-None-Match: "%s"\n' "$EXP_REV"; fi
        if (( report )); then printf 'X-Applied-Revision: %s\n' "$EXP_REV"; fi
    } > "$work/headers"
    code="$(curl -sS --proto =https --connect-timeout 10 --max-time 30 --max-filesize 4096 \
        -H "@$work/headers" -o "$work/body" -w '%{http_code}' "$url" 2>/dev/null)"; rc=$?
    if (( rc != 0 )); then
        log "портал недоступен ($url, curl $rc) — повтор на следующем тике"
        return 0
    fi
    case "$code" in
        200)
            if ! parse_labels "$work/body"; then
                log "ОШИБКА: ответ портала не по контракту /robot-api/v1/labels — метки не тронуты"
                return 1
            fi
            EXP_REV="$P_REV"; EXP_ENV="$P_ENV"; EXP_SPACE="$P_SPACE"
            write_state "$LABELS_EXPECTED" "revision=$EXP_REV"$'\n'"env=$EXP_ENV"$'\n'"space=$EXP_SPACE" \
                || die "не записано $LABELS_EXPECTED"
            ;;
        304)
            if (( ! have_exp )); then
                log "портал ответил 304 без запомненных меток — повтор на следующем тике"
                return 0
            fi
            ;;
        401)
            log "портал не принял токен меток (401) — выпустите токен на портале и выполните bisquite-teleport labels-enable"
            return 0 ;;
        429)
            log "портал ограничил частоту запросов (429) — повтор на следующем тике"
            return 0 ;;
        *)
            log "портал ответил ${code:-?} — повтор на следующем тике"
            return 0 ;;
    esac

    # R3: the state, not the revision. ETag/304 only spares the body; a hand
    # `set TELEPORT_LABELS=…`, a rerun of firstboot or a failed restart are
    # undone here on every tick.
    if ! labels_match; then
        log "метки расходятся с порталом (env=$EXP_ENV, space=$EXP_SPACE) — применяю"
        apply_managed "$EXP_ENV" "$EXP_SPACE" || return 1
    elif [[ "$(applied_revision)" != "$EXP_REV" ]] && has_systemd && [[ -n "${C[TELEPORT_PROXY]}" ]] \
         && ! systemctl is-active --quiet teleport.service; then
        # Written on an earlier tick, but the agent did not come up then.
        log "агент не активен — перезапускаю с метками портала"
        if ! restart_agent; then
            log "ОШИБКА: агент не поднялся за ${RESTART_TIMEOUT} с после перезапуска — journalctl -u teleport"
            return 1
        fi
    fi
    if [[ "$(applied_revision)" != "$EXP_REV" ]]; then
        if agent_running; then
            write_state "$LABELS_APPLIED" "$EXP_REV" || die "не записано $LABELS_APPLIED"
            log "метки портала действуют (env=$EXP_ENV, space=$EXP_SPACE, ревизия $EXP_REV) — портал узнает на следующем тике"
        else
            log "метки записаны, агент не работает — ревизия не отмечена применённой"
        fi
    fi
    return 0
}

# R2: not part of join — join's keys and stdin (the registration secret)
# stay as they were. The token is not a knob: knobs are printed by `status`.
cmd_labels_enable(){
    need_root
    local pair url="" token dir tmp old_url
    for pair in "$@"; do
        case "$pair" in
            URL=*) url="${pair#URL=}" ;;
            *) die "labels-enable: ожидали URL=https://<портал>/robot-api/v1/labels (токен — со stdin)" ;;
        esac
    done
    [[ "$url" =~ $RE_LABELS_URL ]] \
        || die "labels-enable: URL — ожидали https://<хост>[:порт]/robot-api/v1/labels"
    IFS= read -r token || true
    token="${token#"${token%%[![:space:]]*}"}"; token="${token%"${token##*[![:space:]]}"}"
    [[ "$token" =~ $RE_LABELS_TOKEN ]] \
        || die "labels-enable: токен со stdin не прочитан или не по форме (43 знака [A-Za-z0-9_-])"
    load_conf
    old_url="${C[TELEPORT_LABELS_URL]}"
    dir="$(dirname "$LABELS_TOKEN")"
    install -d -m 0755 "$dir" || die "не создать $dir"
    # mktemp creates the file 0600: the token is never readable by others.
    tmp="$(mktemp "$dir/.labels-token.XXXXXX")" || die "не создать файл в $dir"
    printf '%s\n' "$token" > "$tmp" || { rm -f -- "$tmp"; die "токен меток не записан"; }
    if ! { chmod 0600 "$tmp" && mv -f -- "$tmp" "$LABELS_TOKEN"; }; then
        rm -f -- "$tmp"; die "токен меток не записан"
    fi
    # Another portal — the remembered answer of the old one means nothing.
    [[ "$old_url" != "$url" ]] && rm -f -- "$LABELS_EXPECTED" "$LABELS_APPLIED"
    save_conf "TELEPORT_LABELS_URL=$url"
    log "токен меток — в $LABELS_TOKEN (0600), адрес — $url"
    if has_systemd; then
        systemctl enable --now "$LABELS_TIMER" >/dev/null 2>&1 \
            || warn "$LABELS_TIMER не включён — юнитов меток нет? Обновите расширение (update.sh)"
    fi
    cmd_pull
}

cmd_leave(){
    need_root
    if has_systemd; then
        systemctl disable --now teleport.service >/dev/null 2>&1 || true
    fi
    [[ -d "$DATA" ]] && find "$DATA" -mindepth 1 -maxdepth 1 -exec rm -r -f -- {} +
    rm -f "$YAML"
    rm -r -f -- "$ROLLBACK"
    rm -f -- "$REG_SECRET"
    save_conf TELEPORT_PROXY= TELEPORT_TOKEN= TELEPORT_CA_PIN= TELEPORT_JOIN_METHOD=token
    log "отключено: агент выключен, состояние стёрто. Запись ноды в кластере исчезнет по истечении heartbeat или удаляется в админке."
}

cmd_status(){
    load_conf
    local k v
    echo "Ручки ($CONF):"
    for k in "${KEYS[@]}"; do
        v="${C[$k]}"
        # A bound_keypair token name is not a secret: the key in data_dir is.
        [[ "$k" == TELEPORT_TOKEN && -n "$v" && "${C[TELEPORT_JOIN_METHOD]}" != bound_keypair ]] && v="<задан>"
        printf '  %-24s %s\n' "$k" "${v:-—}"
    done
    echo
    echo "Агент: $("$TELEPORT_BIN" version 2>/dev/null | head -1 || echo 'не установлен')"
    if has_systemd; then
        echo "Служба teleport: $(systemctl is-active teleport.service 2>/dev/null), $(systemctl is-enabled teleport.service 2>/dev/null)"
    fi
    if joined; then echo "Регистрация: есть (host_uuid $(cat "$DATA/host_uuid"))"; else echo "Регистрация: нет"; fi
    if [[ "${C[TELEPORT_JOIN_METHOD]}" == bound_keypair ]]; then
        if [[ -s "$REG_SECRET" ]]; then
            echo "Секрет регистрации: задан (стирается после регистрации)"
        else
            echo "Секрет регистрации: нет — подключения идут по связанному ключу в $DATA"
        fi
    fi
    app_role_missing && echo "ВНИМАНИЕ: $APP_ROLE_HINT"
    if [[ -n "${C[TELEPORT_LABELS_URL]}" && -f "$LABELS_TOKEN" ]]; then
        echo "Метки с портала: включено (${C[TELEPORT_LABELS_URL]}, токен задан)"
    elif [[ -n "${C[TELEPORT_LABELS_URL]}" ]]; then
        echo "Метки с портала: выключено — нет токена, bisquite-teleport labels-enable"
    else
        echo "Метки с портала: выключено"
    fi
    if read_expected; then
        local applied="не применены"
        [[ "$(applied_revision)" == "$EXP_REV" ]] && applied="действуют"
        echo "  ожидаемые: env=$EXP_ENV space=$EXP_SPACE (ревизия $EXP_REV), $applied"
    fi
    if [[ -n "${C[TELEPORT_PROXY]}" ]]; then
        local host node; host="$(proxy_host "$(proxy_with_port "${C[TELEPORT_PROXY]}")")"
        node="$(nodename 2>/dev/null || echo '?')"
        echo "Нода: $node, метки: $(node_labels | tr '\t\n' '= ' )"
    fi
    echo
    echo "Приложения:"
    local out k v src icon; out="$(collect_apps)"
    if [[ -z "$out" ]]; then
        echo "  —"
    else
        while IFS=$'\t' read -r k v src icon; do
            [[ -n "$icon" ]] && src="$src, иконка $icon"
            if [[ -n "${host:-}" ]]; then
                printf '  %-16s %-32s https://%s.%s.%s  (%s)\n' "$k" "$v" "$k" "$node" "$host" "$src"
            else
                printf '  %-16s %-32s (%s)\n' "$k" "$v" "$src"
            fi
        done <<< "$out"
    fi
}

case "${1:-}" in
    join) shift; cmd_join "$@" ;;
    set) shift; cmd_set "$@" ;;
    leave) cmd_leave ;;
    status) cmd_status ;;
    render) cmd_render ;;
    apply) shift; cmd_apply "$@" ;;
    scrub-token) need_root; scrub_token ;;
    os-logins) cmd_os_logins; exit 0 ;;
    set-managed) shift; cmd_set_managed "$@" ;;
    pull) cmd_pull ;;
    labels-enable) shift; cmd_labels_enable "$@" ;;
    -h|--help|help|"") sed -n '2,${/^#/!q; s/^# \{0,1\}//; p}' "$0" ;;
    *) die "неизвестная команда '$1' (join|set|leave|status|render|apply|os-logins|set-managed|pull|labels-enable)" ;;
esac
