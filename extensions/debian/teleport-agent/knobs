# Подключение к Teleport — /etc/bisquite/teleport/config (0600: токен).
# Читает `bisquite-teleport render` на каждом старте teleport.service.
# Кластер (прокси и токен) меняется только `bisquite-teleport join`:
# новый прокси при CA старого в /var/lib/teleport не подключится никогда.
# Каждое значение ложится в YAML в двойных кавычках, поэтому шаблоны
# исключают кавычки, переводы строки и `$` (те же списки, что в ldap-admin-api).
#
# ключ                     тип                                                          умолчание  описание
TELEPORT_PROXY             ro:re:^[a-z0-9][a-z0-9.-]{0,252}(:[0-9]{1,5})?$                —   прокси кластера host[:port]; меняется только через bisquite-teleport join (новый кластер — новая регистрация)
TELEPORT_TOKEN             ro:secret:re:^[A-Za-z0-9._-]{8,256}$                           —   join-токен (node[,app]); только через bisquite-teleport join, стирается после регистрации
TELEPORT_CA_PIN            re:^sha256:[0-9a-f]{64}$                                       —   необязательная сверка CA кластера: sha256:<64 hex>
TELEPORT_ENV               "re:^[a-zA-Z0-9][a-zA-Z0-9_./ -]{0,127}$"                      —   метка env — по ней smart_role даёт доступ
TELEPORT_NODENAME          re:^[a-z0-9][a-z0-9-]{1,62}$                                   —   имя ноды, метка DNS; пусто — короткое имя хоста
TELEPORT_LABELS            "list:re:^[a-zA-Z0-9][a-zA-Z0-9_./-]{0,63}=[a-zA-Z0-9][a-zA-Z0-9_./ -]{0,127}$"  —   прочие метки ноды ключ=значение через запятую (env, app, managed_by нельзя)
TELEPORT_APPS              list:re:^[a-z0-9][a-z0-9-]{0,62}=([0-9]{1,5}|https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]*)?)$  —   приложения оператора имя=порт или имя=http(s)://хост[:порт][/путь]
TELEPORT_APPS_DISABLE      list:re:^[a-z0-9][a-z0-9-]{0,62}$                              —   не публиковать объявленные приложения: имена через запятую
TELEPORT_APPS_ICONS        list:re:^[a-z0-9][a-z0-9-]{0,62}=[A-Za-z0-9][A-Za-z0-9._-]{0,63}$  —   иконка приложения в веб-морде прокси: имя=иконка через запятую; имя иконки — ключ вшитого в прокси набора, побеждает ICON= объявления
TELEPORT_APPS_DISCOVERY    bool                                                           1   0 — не читать объявления /etc/bisquite/teleport/apps.d
