[Unit]
Description=Scrub the Teleport join token from /etc/bisquite/teleport

[Service]
Type=oneshot
# PathExists= re-triggers the unit whenever it goes inactive while the file is
# still there: without RemainAfterExit every boot ended in start-limit-hit
# (AGX Orin, 2026-09-14). Scrubbing is idempotent, once per boot is enough.
RemainAfterExit=yes
ExecStart=/usr/local/sbin/bisquite-teleport scrub-token
