[Unit]
Description=Retry the Teleport registration that waits for the network
# Exists while `bisquite-teleport join` waits for the network or the proxy
# (first boot without a link); gone once registered or refused.
ConditionPathExists=/var/lib/bisquite/teleport/join-pending
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The proxy probe is cut at 15 s, the wait for the identity at 120 s.
TimeoutStartSec=5min
# Still waiting ends with code 0 and one journal line: the next tick is the
# retry. A refusal of the cluster fails the unit, its reason is in `status`.
ExecStart=/usr/sbin/bisquite-teleport join-retry

[Install]
# Every boot, after network-online, while the join waits.
WantedBy=multi-user.target
