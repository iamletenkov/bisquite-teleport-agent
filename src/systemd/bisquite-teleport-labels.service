[Unit]
Description=Fetch the Teleport labels space and env from the portal and apply them
# Enabled by `bisquite-teleport labels-enable`; without the token there is
# nothing to ask the portal with.
ConditionPathExists=/etc/bisquite/teleport/labels-token
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# A restart waits up to 30 s for the agent; a stuck curl is cut at 30 s.
TimeoutStartSec=5min
# Network and HTTP errors end with code 0 and one journal line: the next tick
# is the retry. A refused answer or an agent that did not come up fails.
ExecStart=/usr/local/sbin/bisquite-teleport pull
