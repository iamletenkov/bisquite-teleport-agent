[Unit]
Description=Retry the waiting Teleport registration every minute

[Timer]
# A calendar timer fires whether or not the last tick met its condition or
# is still running (a running oneshot is not started twice).
OnCalendar=minutely
AccuracySec=5s
# A fleet that boots together must not hit the proxy in the same second.
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
