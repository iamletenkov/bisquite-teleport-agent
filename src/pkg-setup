#!/usr/bin/env bash
# pkg-setup — what the maintainer scripts of bisquite-teleport-agent do while
# the package files are on disk (postinst configure, prerm remove). postrm
# runs after the files are gone, so it is self-contained (debian/postrm).
#
#   pkg-setup configure [<previous version>]
#   pkg-setup prerm-remove
#
# configure:
#   * registers the schema of the `teleport` domain for bisquite-conf
#     (/opt/bisquite/knobs/teleport{,.apply}); creates
#     /etc/bisquite/teleport/config only if it is missing — an existing file
#     is never rewritten, not even to add defaults;
#   * moves a robot of teleport-agent 2.x (the bisquite extension) onto the
#     package: its unit copies in /etc/systemd/system (they shadow the
#     package's units and exec /usr/local/sbin/bisquite-teleport) are moved
#     to /var/lib/bisquite/teleport/2.x-units/, enablement links that pointed
#     at them now point at /usr/lib/systemd/system, and the CLI link
#     /usr/local/sbin/bisquite-teleport points at /usr/sbin/bisquite-teleport
#     (callers and a rendered /etc/teleport.yaml may still use that path);
#   * enables the two path units on the first install, as the extension did;
#   * never touches /var/lib/teleport (the registration), the labels token,
#     /etc/teleport.yaml and the agent itself: a running teleport.service is
#     not restarted, the next start renders with the new CLI.
#
# BISQUITE_TELEPORT_ROOT — a scratch root for the tests; links that systemd
# reads keep guest paths (no root prefix), as `systemctl enable` makes them.
# BISQUITE_TELEPORT_SYSTEMD=1|0 overrides the detection of a running systemd.
set -euo pipefail

ROOT="${BISQUITE_TELEPORT_ROOT:-}"
export BISQUITE_CONF_ROOT="${BISQUITE_CONF_ROOT:-$ROOT}"
PKG=/usr/lib/bisquite-teleport
LIBDIR="$ROOT$PKG"
UNIT_DIR=/usr/lib/systemd/system
ETC_UNITS="$ROOT/etc/systemd/system"
CLI=/usr/sbin/bisquite-teleport
LEGACY_CLI="$ROOT/usr/local/sbin/bisquite-teleport"
CONF_CLI="$ROOT/usr/local/sbin/bisquite-conf"
KNOBS="$ROOT/opt/bisquite/knobs"
CONF="$ROOT/etc/bisquite/teleport/config"
STATE="$ROOT/var/lib/bisquite/teleport"
LABELS_TOKEN="$ROOT/etc/bisquite/teleport/labels-token"
UNITS=(teleport.service bisquite-teleport-apps.path bisquite-teleport-apps.service
       bisquite-teleport-token.path bisquite-teleport-token.service
       bisquite-teleport-labels.service bisquite-teleport-labels.timer)
PATH_UNITS=(bisquite-teleport-apps.path bisquite-teleport-token.path)
LABELS_TIMER=bisquite-teleport-labels.timer
# What only a teleport.service of the 2.x extension carries.
LEGACY_MARK=/usr/local/sbin/bisquite-teleport

log(){ >&2 echo "bisquite-teleport-agent: $*"; }
warn(){ log "ВНИМАНИЕ: $*"; }

has_systemd(){
    case "${BISQUITE_TELEPORT_SYSTEMD:-}" in
        1) return 0 ;;
        0) return 1 ;;
    esac
    [[ -z "$ROOT" && -d /run/systemd/system ]]
}

# want <target>.wants <unit>: the link `systemctl enable` would make.
want(){
    install -d -m 0755 "$ETC_UNITS/$1"
    ln -sfn "$UNIT_DIR/$2" "$ETC_UNITS/$1/$2"
}

register_schema(){
    local prev=""
    # The bisquite-conf CLI of a bisquite image (its own lib/) stays the one
    # in PATH: conf_init would point it at this package's copy.
    if [[ -L "$CONF_CLI" && -e "$CONF_CLI" ]]; then prev="$(readlink "$CONF_CLI")"; fi
    if [[ -f "$CONF" ]]; then
        install -d -m 0755 "$KNOBS"
        ln -sfn "$LIBDIR/knobs" "$KNOBS/teleport"
        ln -sfn "$LIBDIR/knobs.apply" "$KNOBS/teleport.apply"
        rm -f -- "$KNOBS/teleport.secret"
    else
        install -d -m 0755 "$ROOT/etc/bisquite/teleport"
        # shellcheck source=/dev/null
        source "$LIBDIR/lib/bisquite-conf"
        conf_init teleport "$LIBDIR/knobs" || { log "ОШИБКА: $CONF не создан"; return 1; }
    fi
    if [[ -n "$prev" ]]; then
        ln -sfn "$prev" "$CONF_CLI"
    elif [[ ! -e "$CONF_CLI" && ! -L "$CONF_CLI" ]]; then
        install -d -m 0755 "$(dirname "$CONF_CLI")"
        ln -sfn "$LIBDIR/lib/bisquite-conf" "$CONF_CLI"
    elif [[ -L "$CONF_CLI" && ! -e "$CONF_CLI" ]]; then
        ln -sfn "$LIBDIR/lib/bisquite-conf" "$CONF_CLI"
    fi
}

# Unit copies of the 2.x extension shadow the package's units: /etc wins.
migrate_units(){
    local u f moved=() wants link
    for u in "${UNITS[@]}"; do
        f="$ETC_UNITS/$u"
        [[ -f "$f" && ! -L "$f" ]] || continue
        # bisquite-teleport-* are this agent's names; teleport.service is
        # generic — only the extension's copy runs our CLI.
        if [[ "$u" == bisquite-teleport-* ]] || grep -qF "$LEGACY_MARK" "$f"; then
            [[ -d "$STATE" ]] || install -d -m 0700 "$STATE"
            install -d -m 0700 "$STATE/2.x-units"
            mv -f -- "$f" "$STATE/2.x-units/$u"
            moved+=("$u")
        else
            warn "$f — не юнит bisquite-teleport, он перекрывает юнит пакета; агент пакета не запустится, пока его не убрать"
        fi
    done
    (( ${#moved[@]} )) || return 0
    # Enablement links of the moved copies: same target, the package's unit.
    for u in "${moved[@]}"; do
        for wants in "$ETC_UNITS"/*.wants; do
            link="$wants/$u"
            [[ -L "$link" ]] || continue
            [[ "$(readlink "$link")" == "/etc/systemd/system/$u" ]] && ln -sfn "$UNIT_DIR/$u" "$link"
        done
    done
    log "юниты teleport-agent 2.x перенесены в /var/lib/bisquite/teleport/2.x-units: ${moved[*]}"
}

migrate_cli_link(){
    if [[ -L "$LEGACY_CLI" ]]; then
        [[ "$(readlink "$LEGACY_CLI")" == "$CLI" ]] && return 0
        ln -sfn "$CLI" "$LEGACY_CLI"
        log "/usr/local/sbin/bisquite-teleport → $CLI (было расширение 2.x)"
    elif [[ -e "$LEGACY_CLI" ]]; then
        warn "/usr/local/sbin/bisquite-teleport — не ссылка; он раньше в PATH, чем $CLI"
    fi
}

cmd_configure(){
    local prev="${1:-}" u
    [[ -x "$LIBDIR/bisquite-teleport" ]] || { log "ОШИБКА: нет $PKG/bisquite-teleport"; exit 1; }
    install -d -m 0755 "$ROOT/etc/bisquite/teleport/apps.d"
    [[ -d "$ROOT/var/lib/teleport" ]] || install -d -m 0750 "$ROOT/var/lib/teleport"
    migrate_units
    migrate_cli_link
    register_schema
    if [[ -z "$prev" ]]; then
        # Path units are no-ops until joined: always on, as in the extension.
        for u in "${PATH_UNITS[@]}"; do
            [[ -L "$ETC_UNITS/paths.target.wants/$u" ]] || want paths.target.wants "$u"
        done
    fi
    # A robot with a labels token keeps its timer (2.5.0 enabled it).
    if [[ -f "$LABELS_TOKEN" && ! -L "$ETC_UNITS/timers.target.wants/$LABELS_TIMER" ]]; then
        want timers.target.wants "$LABELS_TIMER"
    fi
    if has_systemd; then
        systemctl daemon-reload || warn "systemctl daemon-reload не прошёл"
        systemctl start "${PATH_UNITS[@]}" || warn "path-юниты не запущены"
        if [[ -f "$LABELS_TOKEN" ]]; then
            systemctl start "$LABELS_TIMER" || warn "$LABELS_TIMER не запущен"
        fi
    fi
    if [[ -s "$ROOT/var/lib/teleport/host_uuid" ]]; then
        log "регистрация в /var/lib/teleport сохранена; агент не перезапускался"
    else
        log "подключение: sudo bisquite-teleport join TELEPORT_PROXY=… TELEPORT_TOKEN=- TELEPORT_ENV=… (токен со stdin)"
    fi
}

# Before the files go: helpers stop, the agent keeps running until a reboot
# (a removal must not cut the session it was started from).
cmd_prerm_remove(){
    if has_systemd; then
        systemctl stop "$LABELS_TIMER" "${PATH_UNITS[@]}" 2>/dev/null || true
    fi
    if [[ -s "$ROOT/var/lib/teleport/host_uuid" ]]; then
        warn "регистрация в /var/lib/teleport и /etc/bisquite/teleport остаётся, в том числе при purge; отключиться — sudo bisquite-teleport leave до удаления пакета"
    fi
}

case "${1:-}" in
    configure) shift; cmd_configure "$@" ;;
    prerm-remove) cmd_prerm_remove ;;
    *) log "использование: pkg-setup configure [<версия>] | prerm-remove"; exit 2 ;;
esac
